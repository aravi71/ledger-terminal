# Copy to .env and fill in what you need. Everything is optional:
# without a Claude credential the terminal, charts, paper trading and
# git-style approvals all work; only the AI agent/panel/heartbeat are off.

# --- Claude (AI agent, investor panel, heartbeat) ---------------------------
# Either set an API key here, or run `ant auth login` once and leave it blank.
ANTHROPIC_API_KEY=

# --- Market data --------------------------------------------------------------
# yahoo = live delayed quotes from Yahoo Finance (no key needed)
# demo  = deterministic synthetic prices, works offline (used by the tests)
LEDGER_MARKET_DATA=yahoo

# --- Server -------------------------------------------------------------------
LEDGER_HOST=127.0.0.1
LEDGER_PORT=3002
# Login (HTTP Basic auth). REQUIRED when LEDGER_HOST is not localhost, e.g. on
# a server or in Docker. Use a long random password and serve over HTTPS.
LEDGER_USERNAME=admin
LEDGER_PASSWORD=
# Where config, the event log, broker state and commit history are stored.
# LEDGER_DATA_DIR=./data

# --- Alpaca PAPER trading (optional) -----------------------------------------
# Only used by accounts with "type": "alpaca" in data/config/accounts.json.
# The Alpaca adapter is hard-wired to paper-api.alpaca.markets.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
